# ---------------------------------------------------------------------------
# Variables d'environnement — Portfolio Lana
# ---------------------------------------------------------------------------
# 1. Copie ce fichier en `.env.local`  (cp .env.local.example .env.local)
# 2. Remplis les valeurs depuis ton projet Supabase :
#    Dashboard Supabase > Project Settings > API
# 3. NE COMMIT JAMAIS `.env.local` (déjà ignoré par git).
# ---------------------------------------------------------------------------

# URL publique du projet Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (safe côté client, protégée par les politiques RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SECRÈTE, uniquement côté serveur, JAMAIS exposée au client.
# Utilisée pour des tâches admin (seed, scripts). Optionnelle pour démarrer.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (utile pour les redirections d'auth, SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
